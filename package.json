{
  "name": "jokers-draw",
  "private": true,
  "version": "1.0.0",
  "description": "2-player draw poker with a 21-card deck and a Joker (vs. AI or online)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,worker -c cyan,magenta \"npm:dev:app\" \"npm:dev:worker\"",
    "dev:app": "vite",
    "dev:worker": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler dev --config server/wrangler.jsonc",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "bench": "vitest run --config scripts/vitest.bench.config.ts --silent=false scripts/bench",
    "diagnose": "vitest run --config scripts/vitest.bench.config.ts --silent=false scripts/diagnose",
    "deploy": "npm run build && wrangler deploy --config server/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0"
  }
}
