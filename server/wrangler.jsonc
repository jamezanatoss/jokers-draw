{
  // Joker's Draw: ONE Worker serves both the game (static assets from ../dist) and the online
  // rooms (one Durable Object per room, PartyServer).
  //   Local:  npm run dev     (Vite + wrangler dev; no Cloudflare login needed)
  //   Deploy: npm run deploy  (builds, checks dist/, then wrangler deploy; needs `npx wrangler login`)
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jokers-draw",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist",
    "not_found_handling": "none",
    // WebSockets and the health check go to the Worker; everything else is a static file.
    "run_worker_first": ["/parties/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "JokerRoom", "class_name": "JokerRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JokerRoom"] }],
  "dev": { "port": 8787 },
  "observability": { "enabled": true }
}
